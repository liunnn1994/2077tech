{
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["cypress", "node", "cypress-real-events", "vite/client"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["e2e/**/*.ts", "../src/experience/runtime.ts"]
}
