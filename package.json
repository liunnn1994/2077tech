{
  "name": "07-data",
  "version": "1.5.1",
  "description": "领起科技",
  "author": "Norris Lau",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "check-types": "turbo check-types",
    "cz": "git-cz",
    "dev": "turbo dev",
    "format": "prettier --ignore-unknown --write",
    "format:pkg": "prettier --ignore-unknown --write package.json",
    "preinstall": "npx only-allow pnpm",
    "lint:fix": "turbo lint:fix",
    "prepare": "simple-git-hooks",
    "semantic-release": "semantic-release --debug",
    "simple-git-hooks": "simple-git-hooks",
    "upgrade:all": "run-s upgrade:deps upgrade:engines format:pkg",
    "upgrade:deps": "npx taze -r -w -I false",
    "upgrade:engines": "node scripts/upgradeEngines.mjs"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged",
    "commit-msg": "npx commitlint -e"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "date-fns": "^4.1.0",
    "lodash-es": "^4.17.23",
    "turbo": "^2.8.10"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.19.11",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^9.39.3",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-oxlint": "^0.15.15",
    "git-cz": "^4.9.0",
    "gray-matter": "^4.0.3",
    "lint-staged": "^15.5.2",
    "npm-run-all2": "^7.0.2",
    "oxlint": "^0.15.15",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^2.5.22",
    "semantic-release": "^24.2.9",
    "sharp": "^0.33.5",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": "24.13.1"
  },
  "volta": {
    "node": "24.13.1",
    "pnpm": "9.15.9"
  }
}
